        return true
    end

    if not LP.Team or not player.Team then
        return true
    end

    return LP.Team ~= player.Team
end

local function CreateESPLine(parent,root,a,b,color)
    if not a or not b then
        return
    end

    local p1 = a.Position
    local p2 = b.Position

    local mid = (p1+p2)/2
    local distance = (p2-p1).Magnitude

    if distance <= 0 then
        return
    end

    local line = Instance.new("LineHandleAdornment")

    line.Name = "SkeletonLine"
    line.Adornee = root
    line.CFrame =
        root.CFrame:ToObjectSpace(
            CFrame.lookAt(mid,p2)
        )

    line.Length = distance
    line.Thickness = 2
    line.Color3 = color
    line.Transparency = 0
    line.AlwaysOnTop = true
    line.ZIndex = 10
    line.Parent = parent
end

local function CreateSkeleton(parent,char,root,color)
    local pairsList = {
        {"Head","UpperTorso"},
        {"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},
        {"LeftUpperArm","LeftLowerArm"},
        {"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},
        {"RightUpperArm","RightLowerArm"},
        {"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},
        {"LeftUpperLeg","LeftLowerLeg"},
        {"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},
        {"RightUpperLeg","RightLowerLeg"},
        {"RightLowerLeg","RightFoot"}
    }

    for _,pair in ipairs(pairsList) do
        local a = char:FindFirstChild(pair[1])
        local b = char:FindFirstChild(pair[2])

        if a and b then
            CreateESPLine(
                parent,
                root,
                a,
                b,
                color
            )
        end
    end

    -- R6
    local torso = char:FindFirstChild("Torso")

    if torso then
        local r6 = {
            {"Head","Torso"},
            {"Torso","Left Arm"},
            {"Torso","Right Arm"},
            {"Torso","Left Leg"},
            {"Torso","Right Leg"}
        }

        for _,pair in ipairs(r6) do
            local a = char:FindFirstChild(pair[1])
            local b = char:FindFirstChild(pair[2])

            if a and b then
                CreateESPLine(
                    parent,
                    root,
                    a,
                    b,
                    color
                )
            end
        end
    end
end

local function CreateESP(player)
