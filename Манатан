    if not root then return end

    local strength =
        math.clamp(
            CFG.GreenLightStrength/100,
            0,
            1
        )

    for i,p in ipairs(GreenParts) do
        p.Transparency =
            CFG.GreenLight
            and (.82-strength*.45)
            or 1

        if CFG.GreenLight then
            local x =
                (i-4)*8

            local y =
                24+
                math.sin(
                    os.clock()*.8+i
                )*3

            local z =
                math.sin(
                    os.clock()*.5+i
                )*8

            p.CFrame =
                CFrame.new(
                    root.Position+
                    Vector3.new(
                        x,
                        y,
                        z
                    )
                )
                * CFrame.Angles(
                    0,
                    math.rad(
                        i*14
                    ),
                    math.sin(
                        os.clock()+i
                    )*.15
                )
        end
    end
