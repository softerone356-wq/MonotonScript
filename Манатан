        Lighting.ExposureCompensation =
            OriginalExposure-amount*1.5

        Lighting.Ambient =
            Color3.fromRGB(25,25,30)

        Lighting.OutdoorAmbient =
            Color3.fromRGB(25,25,30)
    else
        Lighting.Brightness =
            OriginalBrightness

        Lighting.ExposureCompensation =
            OriginalExposure

        Lighting.Ambient =
            OriginalAmbient

        Lighting.OutdoorAmbient =
            OriginalOutdoor
    end
end

