        hum.JumpPower = CFG.JumpPower
    elseif not CFG.AirJump then
        hum.UseJumpPower = true
        hum.JumpPower = OriginalJumpPower
    end
end

--========================================================--
-- NOCLIP
--========================================================--

local function UpdateNoclip()
    local char = LP.Character

    if not char then
        return
    end

    if CFG.Noclip then
        for _,part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then

                if NoclipCache[part] == nil then
                    NoclipCache[part] =
                        part.CanCollide
                end

                part.CanCollide = false
            end
        end
    else
        for part,state in pairs(NoclipCache) do
            if part and part.Parent then
                part.CanCollide = state
            end
        end

        table.clear(NoclipCache)
    end
end

--========================================================--
-- FLY
--========================================================--

local FlyJump = false

UIS.JumpRequest:Connect(function()
    if CFG.AirJump then
        local root = GetRoot()

        if root then
            root.AssemblyLinearVelocity =
                Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    CFG.JumpPower,
                    root.AssemblyLinearVelocity.Z
                )
        end
    end

    if CFG.Fly then
        FlyJump = true

        task.delay(.18,function()
            FlyJump = false
        end)
    end
end)

local function UpdateFly()
    local hum = GetHumanoid()
    local root = GetRoot()

    if not hum or not root then
        return
    end

    if not CFG.Fly then
        return
    end

    -- MoveDirection already follows Roblox
    -- keyboard controls and mobile joystick.

    local horizontal =
        hum.MoveDirection

    local vertical = 0

    if
        UIS:IsKeyDown(
            Enum.KeyCode.Space
        )
        or FlyJump
    then
        vertical = 1
    elseif
        UIS:IsKeyDown(
            Enum.KeyCode.LeftControl
        )
        or
        UIS:IsKeyDown(
            Enum.KeyCode.C
        )
    then
        vertical = -1
    end

    local velocity =
        horizontal*CFG.FlySpeed
        +
        Vector3.new(
            0,
            vertical*CFG.FlySpeed,
            0
        )

    root.AssemblyLinearVelocity =
        velocity

    hum.AutoRotate = false

    pcall(function()
        hum:ChangeState(
            Enum.HumanoidStateType.Freefall
        )
    end)
end

--========================================================--
-- BUNNYHOP
--========================================================--

local BunnyTimer = 0

local function UpdateBunnyhop(dt)
    if not CFG.Bunnyhop then
        return
    end

    local hum = GetHumanoid()
    local root = GetRoot()

    if not hum or not root then
        return
    end

    BunnyTimer += dt

    if BunnyTimer < .12 then
        return
    end

    if hum.MoveDirection.Magnitude < .05 then
        return
    end

    local state = hum:GetState()

    local grounded =
        state == Enum.HumanoidStateType.Running
        or
        state == Enum.HumanoidStateType.Landed
        or
        state == Enum.HumanoidStateType.RunningNoPhysics

    if grounded then
        BunnyTimer = 0

        hum:ChangeState(
            Enum.HumanoidStateType.Jumping
        )

        root.AssemblyLinearVelocity =
            Vector3.new(
                root.AssemblyLinearVelocity.X,
                CFG.BunnyhopPower,
                root.AssemblyLinearVelocity.Z
            )
    end
end

