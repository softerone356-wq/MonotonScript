local function RemoveChinaHat()
    if ChinaHatModel then
        pcall(function()
            ChinaHatModel:Destroy()
        end)

        ChinaHatModel = nil
    end
end

local function CreateChinaHat()
    RemoveChinaHat()

    local head = GetHead()
    if not head then return end

    local model = Instance.new("Model")
    model.Name = "MonotonChinaHat"
    model.Parent = ModelFolder

    local color = RGBToColor(CFG.ChinaHatColor)

    local scale =
        math.clamp(
            CFG.ChinaHatSize/4,
            .65,
            1
        )

    local brimDiameter = 2.45*scale
    local totalHeight =
        1.15*
        math.clamp(
            CFG.ChinaHatHeight/3,
            .7,
            1.15
        )

    -- wide brim
    local brim = Instance.new("Part")
    brim.Name = "WideBrim"
    brim.Shape = Enum.PartType.Cylinder
    brim.Size = Vector3.new(
        .10,
        brimDiameter,
        brimDiameter
    )

    brim.CFrame =
        head.CFrame*
        CFrame.new(0,.48,0)*
        CFrame.Angles(0,0,math.rad(90))

    brim.Anchored = false
    brim.CanCollide = false
    brim.CanTouch = false
    brim.CanQuery = false
    brim.Material = Enum.Material.SmoothPlastic
    brim.Color = color
    brim.Parent = model

    WeldPart(brim,head)

    -- stepped cone
    local rings = 12

    for i = 1,rings do
        local pct = i/rings

        local diameter =
            math.max(
                brimDiameter*.82*
                (1-pct*.92),
                .10
            )

        local y =
            .54+
            totalHeight*pct

        local ring = Instance.new("Part")
        ring.Name = "ConeRing_"..i
        ring.Shape = Enum.PartType.Cylinder

        ring.Size = Vector3.new(
            .11,
            diameter,
            diameter
        )

        ring.CFrame =
            head.CFrame*
            CFrame.new(0,y,0)*
            CFrame.Angles(0,0,math.rad(90))

        ring.Anchored = false
        ring.CanCollide = false
        ring.CanTouch = false
        ring.CanQuery = false
        ring.Material = Enum.Material.SmoothPlastic
        ring.Color = color
        ring.Parent = model

        WeldPart(ring,head)
    end

    local tip = Instance.new("Part")
    tip.Shape = Enum.PartType.Ball
    tip.Size = Vector3.new(.13,.13,.13)
    tip.CFrame =
        head.CFrame*
        CFrame.new(
            0,
            .54+totalHeight+.04,
            0
        )

    tip.Anchored = false
    tip.CanCollide = false
    tip.CanTouch = false
    tip.CanQuery = false
    tip.Material = Enum.Material.SmoothPlastic
    tip.Color = color
    tip.Parent = model

    WeldPart(tip,head)

    ChinaHatModel = model
end

