local function Safe(fn,...)
    return pcall(fn,...)
end

local function RGBToColor(t)
    if type(t) ~= "table" then
        return Color3.fromRGB(255,185,215)
    end

    return Color3.fromRGB(
        math.clamp(tonumber(t[1]) or 255,0,255),
        math.clamp(tonumber(t[2]) or 185,0,255),
        math.clamp(tonumber(t[3]) or 215,0,255)
    )
end

local function ColorToRGB(c)
    return {
        math.floor(c.R*255),
        math.floor(c.G*255),
        math.floor(c.B*255)
    }
end

local function GetAccent()
    return RGBToColor(CFG.AccentColor)
end

local function SetAccent(c)
    CFG.AccentColor = ColorToRGB(c)
end

