local function MakeSkeleton(parent,char,color)
    local root =
        char:FindFirstChild("HumanoidRootPart")

    if not root then return end

    local connections = {
        {"Head","UpperTorso"},
        {"UpperTorso","LowerTorso"},

        {"UpperTorso","LeftUpperArm"},
        {"LeftUpperArm","LeftLowerArm"},
        {"LeftLowerArm","LeftHand"},

        {"UpperTorso","RightUpperArm"},
        {"RightUpperArm","RightLowerArm"},
        {"RightLowerArm","RightHand"},

        {"LowerTorso","LeftUpperLeg"},
        {"LeftUpperLeg","LeftLowerLeg"},
        {"LeftLowerLeg","LeftFoot"},

        {"LowerTorso","RightUpperLeg"},
        {"RightUpperLeg","RightLowerLeg"},
        {"RightLowerLeg","RightFoot"}
    }

    local r6 = {
        {"Head","Torso"},
        {"Torso","Left Arm"},
        {"Torso","Right Arm"},
        {"Torso","Left Leg"},
        {"Torso","Right Leg"}
    }

    local function line(a,b)
        local p1 = char:FindFirstChild(a)
        local p2 = char:FindFirstChild(b)

        if not p1 or not p2 then return end

        local att1 = Instance.new("Attachment")
        att1.Name = "ESP_A"
        att1.Parent = p1

        local att2 = Instance.new("Attachment")
        att2.Name = "ESP_B"
        att2.Parent = p2

        local beam = Instance.new("Beam")
        beam.Name = "Skeleton"
        beam.Attachment0 = att1
        beam.Attachment1 = att2
        beam.Width0 = .035
        beam.Width1 = .035
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.Color = ColorSequence.new(color)
        beam.Transparency =
            NumberSequence.new(0)
        beam.Parent = parent

        att1.Parent = parent
        att2.Parent = parent

        -- preserve world position through attachments
        att1.WorldPosition = p1.Position
        att2.WorldPosition = p2.Position
    end

    for _,pair in ipairs(connections) do
        line(pair[1],pair[2])
    end

    if char:FindFirstChild("Torso") then
        for _,pair in ipairs(r6) do
            line(pair[1],pair[2])
        end
    end
end

local function CreateESP(player)
    if not player.Character then return end
    if not IsEnemy(player) then return end

    local char = player.Character

    local root =
        char:FindFirstChild("HumanoidRootPart")

    local head =
        char:FindFirstChild("Head")

    local hum =
        char:FindFirstChildOfClass("Humanoid")

    if not root or not head then
        return
    end

    local localRoot = GetRoot()

    if localRoot then
        local dist =
            (root.Position-localRoot.Position).Magnitude

        if dist > CFG.ESPDistance then
            return
        end
    end

    local folder = Instance.new("Folder")
    folder.Name = player.Name
    folder.Parent = ESPFolder

    ESPObjects[player] = folder

    local color = GetAccent()

    local style = CFG.ESPStyle

    if style == "Box"
    or style == "Fill Box"
    or style == "Outline Box" then
        MakeBox(
            folder,
            root,
            color,
            style
        )
    end

    if style == "Health" then
        MakeHealth(
            folder,
            root,
            hum,
            color
        )
    end

    if style == "Names" then
        MakeName(
            folder,
            head,
            player,
            color
        )
    end

    if style == "Corner" then
        MakeCorner(
            folder,
            root,
            color
        )
    end

    if style == "Skeleton" then
        MakeSkeleton(
            folder,
            char,
            color
        )
    end

    if CFG.ESPNames
    and style ~= "Names" then
        MakeName(
            folder,
            head,
            player,
            color
        )
    end

    if CFG.ESPHealth
    and style ~= "Health" then
        MakeHealth(
            folder,
            root,
            hum,
            color
        )
    end
end

local function UpdateESP()
    if not CFG.ESP then
        ClearESP()
        return
    end

    ClearESP()

    for _,player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            CreateESP(player)
        end
    end
end

