local FlyJump = false

UIS.JumpRequest:Connect(function()
    if CFG.AirJump and not CFG.Fly then
        local root = GetRoot()

        if root then
            root.AssemblyLinearVelocity =
                Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    CFG.JumpPower,
                    root.AssemblyLinearVelocity.Z
                )
        end
    end

    if CFG.Fly then
        FlyJump = true

        task.delay(.15,function()
            FlyJump = false
        end)
    end
end)

local function UpdateFly()
    local hum = GetHumanoid()
    local root = GetRoot()

    if not hum or not root then
        return
    end

    if not CFG.Fly then
        return
    end

    local move =
        hum.MoveDirection

    local vertical = 0

    if UIS:IsKeyDown(Enum.KeyCode.Space)
    or FlyJump then
        vertical = 1

    elseif UIS:IsKeyDown(Enum.KeyCode.LeftControl)
    or UIS:IsKeyDown(Enum.KeyCode.RightControl)
    or UIS:IsKeyDown(Enum.KeyCode.C) then
        vertical = -1
    end

    local velocity =
        move*CFG.FlySpeed+
        Vector3.new(
            0,
            vertical*CFG.FlySpeed,
            0
        )

    root.AssemblyLinearVelocity =
        velocity

    hum.AutoRotate = false

    pcall(function()
        hum:ChangeState(
            Enum.HumanoidStateType.Freefall
        )
    end)
end

