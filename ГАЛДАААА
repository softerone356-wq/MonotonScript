            TextSize = 12,
            Font = FONTS.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 114
        },
        frame
    )

    local sw = New(
        "TextButton",
        {
            Position = UDim2.new(1,-48,.5,-11),
            Size = UDim2.fromOffset(38,22),
            BackgroundColor3 = default and GetAccent() or DARK3,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
