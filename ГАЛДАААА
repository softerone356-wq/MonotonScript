    local strength =
        math.clamp(
            CFG.GreenLightStrength/100,
            0,1
        )

    local t = os.clock()

    for i,p in ipairs(GreenParts) do
        if not CFG.GreenLight then
            p.Transparency = 1
            continue
        end

        p.Transparency =
            .84-strength*.55

        local x = (i-4.5)*8

        local y =
            25+
