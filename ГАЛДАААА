local function ClearSakuraAura()
    for _,obj in ipairs(AuraObjects) do
        pcall(function()
            obj:Destroy()
        end)
    end

    table.clear(AuraObjects)
end

local function BuildSakuraAura()
    ClearSakuraAura()

    if not CFG.SakuraAura then
        return
    end

    for i=1,math.max(1,CFG.SakuraAuraAmount) do
        local p = Instance.new("Part")

        p.Name = "SakuraPetal"
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.Material = Enum.Material.SmoothPlastic
        p.Color = Color3.fromRGB(255,155,195)
        p.Size = Vector3.new(.16,.04,.34)
        p.Parent = AuraFolder

        p:SetAttribute("Index",i)

        table.insert(AuraObjects,p)
    end
end

local LastAuraEnabled = false
local LastAuraAmount = 0

local function UpdateSakuraAura()
    if LastAuraEnabled ~= CFG.SakuraAura
    or LastAuraAmount ~= CFG.SakuraAuraAmount then

        LastAuraEnabled = CFG.SakuraAura
        LastAuraAmount = CFG.SakuraAuraAmount

        BuildSakuraAura()
    end

    if not CFG.SakuraAura then
        return
    end

    local root = GetRoot()
    if not root then return end

    local now = os.clock()
    local count = #AuraObjects

    if count == 0 then return end

    for _,petal in ipairs(AuraObjects) do
        if petal.Parent then
            local i =
                petal:GetAttribute("Index")
                or 1

            local angle =
                now*.8+
                (i/count)*math.pi*2

            local radius =
                CFG.SakuraAuraRadius+
                math.sin(now*1.5+i)*.35

            local y =
                1.0+
                math.sin(now*1.7+i)*1.35

            local pos =
                root.Position+
                Vector3.new(
                    math.cos(angle)*radius,
                    y,
                    math.sin(angle)*radius
                )

            petal.CFrame =
                CFrame.lookAt(
                    pos,
                    root.Position
                )*
                CFrame.Angles(
                    0,
                    0,
                    math.sin(now*2+i)
                )
        end
    end
end

